# =============================================================================
# stampchain.io — ECX chain profile (example, NO secrets): ecx.env.example
#
# (Named ecx.env.example, not .env.ecx.example: CI rejects .env* files other
# than .env.example/.template/.sample.)
# ECX is the ecash.com Bitcoin fork (first ECX block 973728). Copy to .env (or
# the deploy task definition) and fill in the blanks. Every value below must
# point at ECX infrastructure: a Bitcoin endpoint here would mix Bitcoin state
# into ECX responses. Leaving CHAIN unset (or CHAIN=bitcoin) keeps the app on
# Bitcoin, byte-identical to today.
# =============================================================================

# --- Chain -------------------------------------------------------------------
CHAIN=ecx
# Broadcasts and signed-tx acceptance stay OFF until ECX is verified end to end.
# Any value other than "true" means off.
ECX_BROADCAST_ENABLED=false

# --- Counterparty (ECX) ------------------------------------------------------
# Our ECX Counterparty node ONLY. Under CHAIN=ecx there is no public fallback
# (the public node indexes Bitcoin); the app refuses to start without this.
XCP_PRIMARY_NODE_URL=http://<ecx-counterparty-host>:4000/v2
# Optional tuning (defaults shown)
# XCP_PRIMARY_MAX_CONCURRENCY=8
# XCP_PRIMARY_TIMEOUT_MS=5000
# Do NOT set XCP_API_URL here: it is for CI mock servers and replaces the list.

# --- UTXOs / explorer (ECX esplora) ------------------------------------------
# Esplora-compatible API, NO /api prefix. Required under CHAIN=ecx: the app
# refuses to start without it (the default is Bitcoin's mempool.space).
MEMPOOL_API_URL=https://esplora.ecash.ninja
# Defaults to MEMPOOL_API_URL under CHAIN=ecx; set only to use a second ECX esplora.
# BLOCKSTREAM_API_URL=https://esplora.ecash.ninja
# QuickNode is Bitcoin-only: leave both unset.
QUICKNODE_ENDPOINT=
QUICKNODE_API_KEY=

# --- ECX node RPC ------------------------------------------------------------
# NOT read by stampchain.io today (the app has no node RPC client; UTXOs come
# from esplora, transactions are composed by Counterparty). Recorded here for
# the ECX indexer / Counterparty node, which do need it.
ECX_NODE_RPC_URL=http://<ecx-node-host>:8332
ECX_NODE_RPC_USER=
ECX_NODE_RPC_PASSWORD=

# --- ECX indexer database (MySQL, read-only user) ----------------------------
DB_HOST=<ecx-indexer-mysql-host>
DB_PORT=3306
DB_USER=<read-only-user>
DB_PASSWORD=
DB_NAME=<ecx-indexer-db>
DB_MAX_RETRIES=5

# --- Cache -------------------------------------------------------------------
# Use a SEPARATE Redis/ElastiCache from Bitcoin. Cache keys carry no chain
# prefix, so a shared Redis would serve Bitcoin's cached answers to ECX.
CACHE=true
ELASTICACHE_ENDPOINT=<ecx-redis-host>
ELASITCACHE_PORT=6379

# --- Service fees (ECX) ------------------------------------------------------
# A SEPARATE ECX address you control. Never reuse the Bitcoin fee address:
# keys and balances are chain-separate after the fork.
MINTING_SERVICE_FEE=2500
MINTING_SERVICE_FEE_ADDRESS=<ecx-fee-address>
# API callers pay no fee by default; SRC-20 multisig fees stay off.
# MINTING_SERVICE_FEE_FIXED_SATS=
MINTING_SERVICE_FEE_ENABLED=0
# MARA Slipstream submits to Bitcoin mining pools: leave MARA unset/disabled on ECX.
ENABLE_MARA_INTEGRATION=false

# --- App ---------------------------------------------------------------------
DENO_ENV=production
APP_DOMAIN=<ecx-domain>
ALLOWED_DOMAINS=<ecx-domain>
CSRF_SECRET_KEY=
