---
description: "Outlines common development tasks, scripts for running, building, and previewing the application."
globs: ["deno.json"]
alwaysApply: true
---
development_workflow:
  environments:
    development:
      command: "deno task dev"
      options: "--inspect --allow-all --watch --no-clear-screen"
      local_https:
        flag: "LOCAL_HTTPS in lib/utils/dataPlaceholderProd.ts"
        committed_default: false
        crash: "LOCAL_HTTPS is true but localhost-cert.pem / localhost-key.pem are missing."
        fix: "Set LOCAL_HTTPS = false unless the developer generated gitignored localhost-*.pem and wants https://localhost:8000"
      excludes:
        - "dist/"
        - "node_modules/"
        - "_fresh/"
        - ".git/"
        - "coverage/"
        - "tmp/"
        - "tests/"
        - "fresh.gen.ts"
    production:
      command: "deno task start"
      prerequisites: "check_version"
  other_tasks:
    build: "deno run --unstable-byonm -A main.ts build"
    preview: "deno run -A main.ts"
    update_fresh: "deno run -A -r https://fresh.deno.dev/update ."
    cleanup: "deno run --allow-run scripts/cleanup.ts"
    dev_safe: "deno task cleanup && deno task dev"
